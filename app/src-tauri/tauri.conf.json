{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roo Voice",
  "version": "2.0.0",
  "identifier": "ai.abliter8.roo-voice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Roo Voice",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../engine/dist/roo-engine/": "roo-engine/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRjJDN0I3NEE0MTU0MjgKUldRb1ZFRkt0OGZ5RUFKNkpRSWs1TDhhR2NFczkyZW9wWWo2OGJweldzaWNhNzFlZittNUNEUzQK",
      "endpoints": [
        "https://github.com/abliter8-ai/roo-voice-tts/releases/latest/download/latest.json"
      ]
    }
  }
}